diff --git a/src/mumble/CMakeLists.txt b/src/mumble/CMakeLists.txt
index 1f3daa534..4267504a8 100644
--- a/src/mumble/CMakeLists.txt
+++ b/src/mumble/CMakeLists.txt
@@ -1247,3 +1247,54 @@ if(packaging AND WIN32)
 		WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/installer/client
 	)
 endif()
+
+# ---------------------------------------------------------------- Ruumble Client (ADR-0024)
+# Ruumble's core is compiled from a Ruumble checkout by path; the Ruumble repo stays unchanged.
+option(ruumble "Build Ruumble into the client (Ruumble Client)." ON)
+
+if(ruumble)
+	set(RUUMBLE_SOURCE_DIR "${CMAKE_SOURCE_DIR}/../Ruumble" CACHE PATH "Ruumble checkout whose plugin core is built in")
+	get_filename_component(RUUMBLE_SOURCE_DIR "${RUUMBLE_SOURCE_DIR}" ABSOLUTE)
+	set(RUUMBLE_CORE_DIR "${RUUMBLE_SOURCE_DIR}/plugin/src")
+	if(NOT EXISTS "${RUUMBLE_CORE_DIR}/core.h")
+		message(FATAL_ERROR "Ruumble core not found in ${RUUMBLE_CORE_DIR} (set RUUMBLE_SOURCE_DIR)")
+	endif()
+
+	# the core reports the plugin version to the service, so take the one of the checkout
+	file(STRINGS "${RUUMBLE_SOURCE_DIR}/plugin/CMakeLists.txt" RUUMBLE_PROJECT_LINE REGEX "^project\\(ruumble_plugin VERSION")
+	string(REGEX MATCH "VERSION ([0-9]+\\.[0-9]+\\.[0-9]+)" _ "${RUUMBLE_PROJECT_LINE}")
+	set(RUUMBLE_CORE_VERSION "${CMAKE_MATCH_1}")
+	message(STATUS "Ruumble Client: core ${RUUMBLE_CORE_VERSION} from ${RUUMBLE_SOURCE_DIR}")
+
+	include(FetchContent)
+	set(USE_TLS ON CACHE BOOL "" FORCE)
+	set(USE_OPEN_SSL ON CACHE BOOL "" FORCE)
+	set(USE_ZLIB OFF CACHE BOOL "" FORCE)
+	set(IXWEBSOCKET_INSTALL OFF CACHE BOOL "" FORCE)
+	FetchContent_Declare(ixwebsocket GIT_REPOSITORY https://github.com/machinezone/IXWebSocket.git GIT_TAG v12.0.1 GIT_SHALLOW TRUE)
+	FetchContent_MakeAvailable(ixwebsocket)
+
+	find_pkg(Qt6 COMPONENTS WebEngineWidgets WebChannel REQUIRED)
+
+	target_sources(mumble_client_object_lib PRIVATE
+		"${RUUMBLE_CORE_DIR}/core.cpp"
+		"${RUUMBLE_CORE_DIR}/config.cpp"
+		"${RUUMBLE_CORE_DIR}/discovery.cpp"
+		"${RUUMBLE_CORE_DIR}/messages.cpp"
+		"${RUUMBLE_CORE_DIR}/net.cpp"
+		"ruumble/DeskChannel.cpp"
+		"ruumble/DeskChannel.h"
+		"ruumble/QtMumbleApi.cpp"
+		"ruumble/QtMumbleApi.h"
+		"ruumble/RuumbleIntegration.cpp"
+		"ruumble/RuumbleIntegration.h"
+		"ruumble/RuumbleView.cpp"
+		"ruumble/RuumbleView.h"
+		"ruumble/ruumble-desk.qrc"
+	)
+	target_include_directories(mumble_client_object_lib PRIVATE "${RUUMBLE_CORE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/ruumble")
+	# the full path: on case-insensitive file systems (Windows) Mumble's src/Net.h would answer "net.h"
+	target_compile_definitions(mumble_client_object_lib PUBLIC USE_RUUMBLE RUUMBLE_CORE_VERSION="${RUUMBLE_CORE_VERSION}"
+		RUUMBLE_CORE_NET_H="${RUUMBLE_CORE_DIR}/net.h")
+	target_link_libraries(mumble_client_object_lib PUBLIC ixwebsocket Qt6::WebEngineWidgets Qt6::WebChannel)
+endif()
